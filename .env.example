# Jev decisions. Direct: https://api.typesafe.ai/v1/systemone with a console.typesafe.ai key.
# Through OpenRouter: https://openrouter.ai/api/alpha/decisions, model ~typesafe/jev-latest, OpenRouter key.
TYPESAFE_API_KEY=
TYPESAFE_URL=https://openrouter.ai/api/alpha/decisions
TYPESAFE_MODEL=~typesafe/jev-latest
# System 2. With a key it calls the Anthropic API, without one it shells out to the `claude` CLI.
ANTHROPIC_API_KEY=
SYSTEM2_MODEL=claude-fable-5-1
